# Copiá este archivo como .env y completá tus valores reales.
# El .env NUNCA se sube a Git ni entra en la imagen de Docker.

PORT=8080
NODE_ENV=development

# Cadena de conexión a MongoDB (Atlas o local)
MONGO_URL=mongodb+srv://USUARIO:PASSWORD@cluster0.xxxxx.mongodb.net/adoptme

# Secreto para firmar los JWT (generá uno largo y aleatorio)
JWT_SECRET=reemplazar-por-un-secreto-largo-y-aleatorio

# Opcional: base para los tests. Si no la definís, los tests usan MongoDB en memoria.
# MONGO_URL_TEST=mongodb://127.0.0.1:27017/adoptme_test
